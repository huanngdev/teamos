{
  "name": "teamos",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:check": "bun run --cwd packages/db db:check",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "seed": "bun run --cwd apps/api seed",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "oxfmt -c packages/config/oxfmt.json --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check -c packages/config/oxfmt.json --ignore-path .oxfmtignore",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "typecheck": "bun run check-types",
    "check": "bun run format:check && turbo run lint check-types test build"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.10",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.3.14"
}
