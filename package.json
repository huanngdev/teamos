{
  "name": "teamos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "db:check": "bun run --cwd packages/db db:check",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "start": "turbo run start --ui=tui",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "typecheck": "bun run check-types",
    "check": "turbo run lint check-types test build"
  },
  "devDependencies": {
    "@teamos/prettier-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6"
  }
}
