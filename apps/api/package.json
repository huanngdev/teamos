{
  "name": "@teamos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "rm -rf dist && bun build src/server.ts --target=bun --outdir=dist --sourcemap=external",
    "start": "bun dist/server.js",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "benchmark:issues": "bun scripts/benchmark-issues.ts",
    "verify:isolation": "bun scripts/verify-organization-isolation.ts",
    "seed": "bun scripts/seed/index.ts",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@loglayer/hono": "^2.4.0",
    "@loglayer/plugin-redaction": "^4.1.0",
    "@loglayer/transport-simple-pretty-terminal": "^3.3.0",
    "@scalar/hono-api-reference": "^0.12.18",
    "@teamos/db": "workspace:*",
    "@teamos/shared": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "loglayer": "^9.4.0",
    "nodemailer": "^10.3.1",
    "rate-limiter-flexible": "^11.3.0",
    "serialize-error": "^13.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@teamos/config": "workspace:*",
    "bun-types": "^1.4.4",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
