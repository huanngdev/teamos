{
  "name": "@teamos/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../packages/shared build && bun --watch src/server.ts",
    "build": "bun run --cwd ../../packages/shared build && rm -rf dist && bun build src/server.ts --target=bun --outdir=dist --sourcemap=external",
    "start": "bun dist/server.js",
    "test": "bun run --cwd ../../packages/shared build && bun test src",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@loglayer/hono": "^2.4.0",
    "@loglayer/plugin-redaction": "^4.1.0",
    "@loglayer/transport-simple-pretty-terminal": "^3.3.0",
    "@teamos/shared": "workspace:*",
    "hono": "^4.9.7",
    "ioredis": "^6.0.0",
    "loglayer": "^9.4.0",
    "rate-limiter-flexible": "^11.2.0",
    "serialize-error": "^13.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@teamos/eslint-config": "workspace:*",
    "@teamos/prettier-config": "workspace:*",
    "@teamos/typescript-config": "workspace:*",
    "bun-types": "^1.2.21",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2"
  }
}
