{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@teamos/config/tsconfig/bun.json",
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules"]
}
