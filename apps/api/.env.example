# API server
PORT=4001
NODE_ENV=development
API_DOCS_ENABLED=true

# Browser origins allowed to call the API. Separate multiple origins with commas.
CORS_ORIGINS=http://localhost:4000
# Public origin of the web app. Used to build verification and invitation links.
WEB_URL=http://localhost:4000
LOG_LEVEL=info

# HTTP safeguards
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
IDLE_TIMEOUT_SECONDS=30
STARTUP_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000

# Redis-backed request rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POINTS=300
RATE_LIMIT_DURATION_SECONDS=60

# Authentication
# Use `bun x auth@1.7.5 secret` to generate a strong secret.
BETTER_AUTH_SECRET=teamos-development-auth-secret-change-before-production
# Public origin of the API used for OAuth callbacks.
BETTER_AUTH_URL=http://localhost:4001
# Maximum number of workspaces a user may belong to before creating is blocked.
MAX_ORGANIZATIONS_PER_USER=3

# Social sign-in providers. Set both values of a provider to enable it.
# Google OAuth callback: ${BETTER_AUTH_URL}/api/auth/callback/google
# GitHub OAuth callback: ${BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email (Resend). Required in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Connections to local infrastructure started with `docker compose` at the repository root.
DATABASE_URL=postgresql://teamos_user:teamos_password@localhost:5432/teamos
REDIS_URL=redis://:teamos_password@localhost:6379

# Object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=teamos_user
MINIO_SECRET_KEY=teamos_password
MINIO_REGION=us-east-1
