{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": ["VITE_API_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "API_DOCS_ENABLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "IDLE_TIMEOUT_SECONDS",
        "LOG_LEVEL",
        "MAX_REQUEST_BODY_BYTES",
        "MINIO_ACCESS_KEY",
        "MINIO_ENDPOINT",
        "MINIO_REGION",
        "MINIO_SECRET_KEY",
        "NODE_ENV",
        "PORT",
        "RATE_LIMIT_DURATION_SECONDS",
        "RATE_LIMIT_ENABLED",
        "RATE_LIMIT_POINTS",
        "REDIS_URL",
        "REQUEST_TIMEOUT_MS",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "SHUTDOWN_TIMEOUT_MS",
        "STARTUP_TIMEOUT_MS",
        "VITE_API_URL",
        "WEB_URL"
      ],
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "API_DOCS_ENABLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "IDLE_TIMEOUT_SECONDS",
        "LOG_LEVEL",
        "MAX_REQUEST_BODY_BYTES",
        "MINIO_ACCESS_KEY",
        "MINIO_ENDPOINT",
        "MINIO_REGION",
        "MINIO_SECRET_KEY",
        "NODE_ENV",
        "PORT",
        "RATE_LIMIT_DURATION_SECONDS",
        "RATE_LIMIT_ENABLED",
        "RATE_LIMIT_POINTS",
        "REDIS_URL",
        "REQUEST_TIMEOUT_MS",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "SHUTDOWN_TIMEOUT_MS",
        "STARTUP_TIMEOUT_MS",
        "VITE_API_URL",
        "WEB_URL"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build", "^test"]
    }
  }
}
