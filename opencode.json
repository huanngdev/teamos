{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "reasoningEffort": "high",
      "permission": "allow"
    }
  },
  "mcp": {
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    }
  }
}
