# Docker Compose variables for compose.prod.yaml on the server.
# Copy to `.env` on the server. Runbook: docs/deployment.md.
COMPOSE_FILE=compose.prod.yaml

# Public hostname whose DNS A record points at the server, without a scheme.
APP_DOMAIN=teamos.example.com

# These values are embedded in connection URLs. Generate each one with
# `openssl rand -hex 32` so they contain no URL-reserved characters.
POSTGRES_DB=teamos
POSTGRES_USER=teamos
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=teamos
MINIO_ROOT_PASSWORD=
