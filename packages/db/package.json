{
  "name": "@teamos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./repositories": "./dist/repositories/index.mjs",
    "./schema": "./dist/schema/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1 --port 4983",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "check-types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@teamos/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@teamos/config": "workspace:*",
    "bun-types": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
